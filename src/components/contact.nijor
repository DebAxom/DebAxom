<body>
    <div class="container" id="contact">

        <div class="form">
            <h1>Contact</h1>

            <input type="text" placeholder="Name">
            <input type="email" placeholder="Email">
            <textarea placeholder="Message" rows="6"></textarea>

            <button>Send Message</button>
        </div>

        <div class="contact-side">
            <p><strong>Email</strong> debaxom@gmail.com</p>
            <p><strong>Location</strong> Guwahati, Assam</p>

            <div class="links">
                <a href="https://github.com/DebAxom" target="_blank">GitHub</a>
                <a href="https://linkedin.com/in/debaxom" target="_blank">LinkedIn</a>
                <a href="https://x.com/debaxom" target="_blank">Twitter</a>
            </div>

            <p class="note">Open to collaborations, ideas, and interesting problems.</p>
        </div>

    </div>
</body>

<style>
    .container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;

        padding: clamp(40px, 6vw, 80px) 8%;
        width: 100%;
    }

    @media (min-width: 768px) {
        .container {
            flex-direction: row;
            align-items: center;
            gap: 80px;
        }

        .form {
            flex: 1;
        }

        .contact-side {
            flex: 1;
            max-width: 420px;
        }
    }

    h1 {
        margin-bottom: 20px;
        font-size: clamp(32px, 3vw, 40px);
        line-height: 1.2;
    }

    .form {
        width: 100%;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    input,
    textarea {
        border: 1px solid rgba(0, 0, 0, 0.15);
        background: rgba(255, 255, 255, 0.6);
        color: black;

        padding: 12px 14px;
        border-radius: 10px;

        font-size: 15px;
        outline: none;

        transition: all 0.2s ease;
    }

    input:focus,
    textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(247, 255, 2, 0.2);
    }

    textarea {
        resize: none;
    }

    button {
        margin-top: 10px;
        padding: 12px;

        border: none;
        border-radius: 999px;

        background-color: #0099ff;

        font-weight: 600;
        cursor: pointer;

        transition: all 0.25s ease;
    }

    button:hover {
        transform: translateY(-2px);
        background-color: #2563eb;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .contact-side {
        display: flex;
        flex-direction: column;
        gap: 18px;

        font-size: 15px;
        line-height: 1.6;

        padding: 32px;
        border-radius: 16px;

        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(0, 0, 0, 0.08);

        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);

        backdrop-filter: blur(10px);

        transition: all 0.25s ease;
    }

    .contact-side:hover {
        transform: translateY(-4px);
    }

    .contact-side p {
        margin: 0;
    }

    .contact-side strong {
        display: block;
        font-weight: 600;
        margin-bottom: 2px;
    }

    /* LINKS */
    .links {
        display: flex;
        gap: 12px;
        margin: 5px 0;
    }

    .links a {
        font-size: 14px;
        text-decoration: none;
        color: var(--accent);
        transition: all 0.2s ease;
    }

    .links a:hover {
        color: #00c8ff;
        transform: translateY(-2px) scale(1.05);
    }

    /* NOTE */
    .note {
        font-size: 14px;
        opacity: 0.7;
        margin-top: 10px;
    }
</style>

<style theme="dark">
    /* INPUTS DARK */
    input,
    textarea {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
    }

    input:focus,
    textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(247, 255, 2, 0.15);
    }

    /* CARD DARK */
    .contact-side {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    button:hover {
        background-color: #3b82f6;
    }
    
    button{
        color: white !important;
    }
</style>