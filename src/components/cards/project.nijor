<body props="{title, img, html, url, cta}">
    <div class="project">

        <div class="content">
            <h1>{title}</h1>
            <div class="desc">{html}</div>
            <a href="{url}" target="_blank"><button>{cta} →</button></a>
        </div>

        <div class="image">
            <img src="images/projects/{img}" alt="{title}">
        </div>

    </div>
</body>

<style>
    .project {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: clamp(16px, 2vw, 32px);

        width: 100%;
        padding: clamp(16px, 2vw, 24px);
        margin: 24px 0;

        background: rgb(235, 235, 235);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);

        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .project:hover {
        transform: translateY(-6px);
        box-shadow: rgba(0, 153, 255, 0.7) 0px 4px 12px;
        box-shadow: 0 25px 50px rgba(0, 153, 255, 0.7);

    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 60%;
    }

    h1 {
        font-size: clamp(22px, 2.5vw, 32px);
        line-height: 1.2;
    }

    .desc {
        font-size: clamp(13px, 1.4vw, 15px);
        opacity: 0.75;
        line-height: 1.6;
    }

    button {
        margin-top: 10px;
        padding: 6px 16px;
        width: fit-content;
        background: transparent;
        border: 1px solid var(--accent);
        color: var(--accent);
        border-radius: 999px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    button:hover {
        background: var(--accent);
        color: black;
    }

    .image {
        flex-shrink: 0;
        width: clamp(110px, 12vw, 160px);
        height: clamp(110px, 12vw, 160px);
        border-radius: 12px;
        overflow: hidden;
        /* background: #111; */
    }

    .image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 768px) {
        .project {
            flex-direction: column-reverse;
            align-items: flex-start;
        }

        .content {
            max-width: 100%;
        }

        .image {
            width: 100%;
            aspect-ratio: 1 / 1;
            height: auto;
        }
    }
</style>

<style theme="dark">
    .project{
        background-color: #212121;
    }
</style>