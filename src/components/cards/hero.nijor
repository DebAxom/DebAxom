<body props="{title, html, no, bg, txt, text, icon}">
    <div class="card card-{no}" style="background-image: {bg};">

        <div class="card-content">

            <!-- LEFT: TEXT -->
            <div class="card-left">
                <div class="card-title-mask">
                    <h1 style="background-image: {txt};">{title}</h1>
                </div>

                <div class="card-bottom">
                    <span style="color : {text};">{html}</span>
                </div>
            </div>

            <!-- RIGHT: ICON -->
            <div class="card-icon">
                <img src="{icon}" alt="icon">
            </div>

        </div>

    </div>
</body>

<style>
    .card {
        position: absolute;
        width: 75%;
        height: 65%;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #1f1f1f;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 1), inset 0 1px 0 #2a2a2a;
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease, z-index 0.2s ease;
    }

    .card-content {
        position: relative;
        padding: 20px;
        height: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-left {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        max-width: 70%;
    }

    /* TEXT MASK */
    .card-title-mask h1 {
        font-size: 56px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 1px;
        color: transparent;
        display: inline-block;
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .card-bottom span {
        font-size: 13px;
        line-height: 1.5;
    }

    /* ICON */
    .card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .card-icon img {
        width: 160px;
        height: 160px;
        object-fit: contain;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    /* Hover */
    @media (min-width: 768px) {

        .card {
            transform-origin: center;
        }

        .card:hover {
            z-index: 10;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 1), inset 0 1px 0 #333;
        }

        .card:hover .card-icon img {
            transform: scale(1.1);
            opacity: 1;
        }

        .card-1 {
            top: 22%;
            left: 8%;
            transform: scale(0.95);
        }

        .card-2 {
            top: 14%;
            left: 22%;
            transform: scale(0.97);
        }

        .card-3 {
            top: 6%;
            left: 36%;
            transform: scale(1);
        }

        .card-1:hover {
            transform: translateY(-30px) scale(1.02) !important;
        }

        .card-2:hover {
            transform: translateY(-40px) scale(1.04) !important;
        }

        .card-3:hover {
            transform: translateY(-50px) scale(1.06) !important;
        }
    }

    /* Mobile */
    @media (max-width: 768px) {

        .card {
            position: relative !important;
            width: 100%;
            height: 180px;
            transform: none !important;
            box-shadow: none;
            text-align: left;
        }

        .card-left {
            max-width: 100%;
        }

        .card-icon {
            align-self: flex-end;
        }

        .card-icon img {
            width: 120px;
            height: 120px;
        }

        .card-1, .card-2, .card-3 {
            left: initial;
            top: initial;
        }

        .card-title-mask h1 {
            font-size: 40px;
            background-image: linear-gradient(60deg, #008bf6, #007bff);
        }
    }
</style>