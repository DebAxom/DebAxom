<body props="{title, html, no, img}">
    <div class="card card-{no}">

        <div class="card-bg">
            <img src="{img}" alt="{title}">
        </div>

        <div class="card-content">
            <div class="card-top">
                <h1>{title}</h1>
            </div>

            <div class="card-bottom">
                <span>{html}</span>
            </div>
        </div>

    </div>
</body>

<style>
    .card {
        position: absolute;
        width: 75%;
        height: 65%;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
        transition: transform 0.35s ease, z-index 0.2s ease;
    }

    .card-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .card-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.75));
        z-index: 1;
    }

    .card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(0, 153, 255, 0.12), transparent 60%);
        pointer-events: none;
        z-index: 1;
    }

    .card-content {
        position: relative;
        z-index: 2;

        padding: 20px;
        height: 100%;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        color: white;

        h1 {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.4px;
        }
    }

    .card-bottom span {
        font-size: 13px;
        opacity: 0.8;
        line-height: 1.5;
    }

    @media (max-width: 768px) {

        .card {
            position: relative !important;
            width: 100%;
            height: 180px;
            transform: none !important;
            opacity: 1 !important;
        }

        .card-1,.card-2,.card-3 {
            left: initial;
            top: initial;
        }

        .card-content{
            text-align: left;
        }
    }

    @media (min-width: 768px) {

        .card {
            transform-origin: center;
        }

        .card-1 {
            top: 22%;
            left: 8%;
        }

        .card-2 {
            top: 14%;
            left: 22%;
        }

        .card-3 {
            top: 6%;
            left: 36%;
        }

        .card:hover {
            z-index: 10;
        }

        .card-1:hover {
            transform: translateY(-40px) scale(1.03) !important;
        }

        .card-2:hover {
            transform: translateY(-40px) scale(1.03) !important;
        }

        .card-3:hover {
            transform: translateY(-40px) scale(1.03) !important;
        }

        /* ✨ IMAGE ZOOM */
        .card:hover .card-bg img {
            transform: scale(1.05);
        }
    }
</style>