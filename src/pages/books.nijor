<head>
    <title>Books | Deb Axom</title>
</head>
<body>
    <div class="container" id="books">
        <div class="content-wrapper">
            <h1 class="page-title">Books</h1>
            <p class="page-subtitle">A collection of books, coloring books, and folklore anthologies published by Deb Axom.</p>

            <div class="books-container" n:loop var="book" source="books">
                <div class="book-card">
                    <div class="book-cover">
                        <img src="{book.cover}" alt="{book.title}" loading="lazy" />
                    </div>
                    <div class="book-details">
                        <h2 class="book-title">{book.title}</h2>
                        <p class="book-description">{book.description}</p>
                        <a href="{book.link}" target="_blank" rel="noopener noreferrer" class="book-link">
                            <button class="book-btn">Get on Amazon →</button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<style>
    .container {
        display: flex;
        flex-direction: column;
        width: 100vw;
        min-height: calc(100dvh - 70px);
        padding: 0% 8%;
        padding-top: 100px;
        padding-bottom: 60px;
    }

    .content-wrapper {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-title {
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        font-size: clamp(15px, 1.6vw, 18px);
        opacity: 0.75;
        margin-bottom: 36px;
        line-height: 1.5;
    }

    .books-container {
        display: flex;
        flex-direction: column;
        gap: 28px;
        width: 100%;
    }

    .book-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: clamp(20px, 3vw, 40px);
        padding: clamp(20px, 2.5vw, 32px);
        background: rgb(235, 235, 235);
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .book-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 36px rgba(0, 153, 255, 0.25);
    }

    .book-cover {
        flex-shrink: 0;
        width: clamp(110px, 14vw, 160px);
        aspect-ratio: 2 / 3;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
        background: #e0e0e0;
    }

    .book-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .book-card:hover .book-cover img {
        transform: scale(1.04);
    }

    .book-details {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex-grow: 1;
    }

    .book-title {
        font-size: clamp(20px, 2.4vw, 30px);
        font-weight: 700;
        line-height: 1.25;
    }

    .book-description {
        font-size: clamp(14px, 1.5vw, 16px);
        line-height: 1.6;
        opacity: 0.8;
    }

    .book-link {
        width: fit-content;
        margin-top: 8px;
    }

    .book-btn {
        padding: 8px 22px;
        background: transparent;
        border: 1.5px solid var(--accent);
        color: var(--accent);
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .book-btn:hover {
        background: var(--accent);
        color: #fff;
        transform: translateX(3px);
    }

    @media (max-width: 768px) {
        .container {
            padding: 0% 5%;
            padding-top: 90px;
        }

        .book-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .book-cover {
            width: 130px;
        }

        .book-details {
            width: 100%;
        }
    }
</style>

<style theme="dark">
    .book-card {
        background-color: #212121;
        border-color: rgba(255, 255, 255, 0.08);
    }

    .book-card:hover {
        box-shadow: 0 16px 36px rgba(0, 153, 255, 0.35);
    }

    .book-cover {
        background: #181818;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    .book-title {
        color: #f3f4f6;
    }

    .book-description {
        color: #d1d5db;
    }

    .book-btn {
        color: var(--accent);
    }

    .book-btn:hover {
        color: #000;
    }
</style>

<script>
    import books from "@/data/books.js";
    import { gsap } from "gsap";

    export function onMount() {
        window.scrollTo({ top: 0, behavior: 'instant' });
        const header = document.getElementById("header");
        if (header) header.style.top = "0px";

        setTimeout(() => {
            const cards = gsap.utils.toArray(".book-card");
            if (cards.length > 0) {
                gsap.fromTo(cards,
                    {
                        opacity: 0,
                        y: 30,
                        scale: 0.97
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 0.6,
                        stagger: 0.12,
                        ease: "power2.out"
                    }
                );
            }
        }, 30);
    }
</script>