<head>
    <title>Deb Axom</title>
</head>
<body>
    <div class="container">

        <div class="content">
            <h1>404</h1>

            <p class="title">You took a wrong turn.</p>

            <p class="desc">The page you’re looking for doesn’t exist — or maybe it never did.</p>

            <a href="/" class="btn">Go Home →</a>
        </div>

        <div class="visual">
            <div class="glow"></div>
        </div>

    </div>
</body>

<style>
    .container {
        width: 100vw;
        height: 100dvh;

        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 8%;

        background: radial-gradient(circle at top, #111, #000);
        color: white;
    }

    .content {
        max-width: 500px;

        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    h1 {
        font-size: clamp(60px, 10vw, 120px);
        line-height: 1;
        opacity: 0.9;
    }

    .title {
        font-size: 22px;
        font-weight: 600;
    }

    .desc {
        font-size: 14px;
        opacity: 0.7;
        line-height: 1.6;
    }

    .btn {
        margin-top: 10px;

        width: fit-content;
        padding: 10px 18px;

        border-radius: 999px;

        background: var(--accent);
        color: black;

        text-decoration: none;
        font-size: 13px;
        font-weight: 600;

        transition: all 0.25s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 153, 255, 0.3);
    }

    /* VISUAL SIDE */
    .visual {
        flex: 1;
        height: 100%;
        position: relative;
    }

    .glow {
        position: absolute;
        top: 30%;
        left: 40%;

        width: 300px;
        height: 300px;

        background: radial-gradient(circle, #0099ff, transparent);
        filter: blur(100px);
        opacity: 0.4;
    }

    /* MOBILE */
    @media (max-width: 768px) {
        .container {
            flex-direction: column;
            justify-content: center;
            text-align: center;
            gap: 30px;
        }

        .content {
            align-items: center;
        }

        .visual {
            height: 200px;
        }

        .glow {
            left: 50%;
            transform: translateX(-50%);
        }
    }
</style>