<import name="header" source="@/components/header.nijor" />
<import name="footer" source="@/components/footer.nijor" />

<body>
    <header></header>
    <div n:slot style="min-height: calc(100dvh - 70px);"></div>
    <footer></footer>
</body>
<script>
    export function onMount() {
        const header = document.getElementById("header");
        const isMobile = window.innerWidth < 768;
        const desiredHeight = isMobile ? window.innerHeight * 0.8 : window.innerHeight * 1.6;

        const updateHeader = () => {
            if (window.location.pathname !== "/" && window.location.pathname !== "/index.html") {
                header.style.top = "0px";
                return;
            }

            const scrollY = window.scrollY;

            if (scrollY > desiredHeight) {
                header.style.top = "0px";
            } else {
                header.style.top = "-250px";
            }
        };

        updateHeader();
        window.addEventListener("scroll", updateHeader);
    }
</script>